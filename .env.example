# Muse Spark on the Meta Model API. One key is enough to run everything.
META_API_KEY=
# Muse Spark Open on Baseten. With both keys, Baseten goes first and the Meta Model API takes over when it fails.
BASETEN_API_KEY=
# Optional: the Meta Model API model id. Empty means muse-spark-1.3.
META_MODEL=
# Optional: the Baseten model id. Empty means meta-models/muse-spark-open-1026.
BASETEN_MODEL=
# Optional: how many Arena matches play at once, 1 to 10. Empty means 10.
UNFENCED_ARENA_PARALLEL=
# Optional: model calls a day for the Arena, the night and Try again together. Empty means 3000.
UNFENCED_DAILY_CALLS=
