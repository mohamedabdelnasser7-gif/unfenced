{
  "agent": "sales",
  "about": "Answers a store's customers on WhatsApp and takes orders after a plain yes.",
  "case": "One WhatsApp chat with one customer; the case id is the chat id. A chat closes after an hour of quiet; the customer's next message starts a new chat.",
  "fields": ["retail"],
  "stages": ["asking", "ordering", "my_order"],
  "actions": {
    "reply": "One answer to a customer message: a reply checked before it goes out, or a fixed line.",
    "order": "An order summary, then the order once the customer says a plain yes."
  },
  "results": {
    "replied": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                "about": "The reply passed the send check and went out, or a fixed line went out."},
    "check_failed": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                     "about": "A draft reply failed the send check and was not sent; one row per blocked reply, with the check's feedback."},
    "limited": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                "about": "Over a model call limit: no model call made, one fixed line once per window."},
    "model_error": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                    "about": "The model did not answer; the customer was asked to write again."},
    "turn_failed": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                    "about": "The code crashed during the turn; the same line went out, and a second in a row is no safe reply."},
    "no_safe_reply": {"speed": "fast", "shows_in_days": [0, 0], "after": "reply",
                      "about": "No safe reply could be sent (three failed send checks or two model errors in a row): nothing went out (only the order line, when the turn made an order) and the agent kept the chat. The chat counts as lost for Reflection and the Arena."},
    "order_drafted": {"speed": "fast", "shows_in_days": [0, 0], "after": "order",
                      "about": "draft_order made a summary, with its total."},
    "order_created": {"speed": "fast", "shows_in_days": [0, 1], "after": "order",
                      "about": "The customer said yes and the store took the order, with its number, total and COD risk. It settles a case as good. A chat closes after an hour with no customer message (a notice at 30 minutes, then 30 more); closed with no order, it is chat_closed, which counts as not good."},
    "chat_closed": {"speed": "fast", "shows_in_days": [0, 0],
                    "about": "The chat closed after quiet with no order: 30 minutes with no customer message, the notice, then 30 more. It settles the case as not good at once, so the fast note is written and that night's Reflection counts the chat as lost."},
    "person_replied": {"speed": "fast", "shows_in_days": [0, 1],
                       "about": "A team member's reply in a chat imported from the store's past; its step is the example the reflection reads."},
    "delivered": {"speed": "slow", "shows_in_days": [2, 7],
                  "about": "The courier delivered the order (Bosta, optional). The second signal of a good chat, recorded on that chat; it never decides a case."},
    "refused": {"speed": "slow", "shows_in_days": [2, 7],
                "about": "The customer refused the order at delivery, or Bosta returned it to the store (Bosta, optional). The second signal of a good chat, recorded on that chat; it never decides a case."}
  },
  "causes": {
    "out_of_stock": "The item ran out.",
    "price": "The price put the customer off.",
    "area": "The customer's area."
  },
  "source": {
    "about": "The person writing in, in one chat, so the chat id names them in the log. Their next chat after one closes is a new case; the fast note follows them there (reflection/fast.py).",
